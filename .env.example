# Local development only. Copy to .env and replace the password.
APP_ENV=local
POSTGRES_DB=unipath
POSTGRES_USER=unipath
POSTGRES_PASSWORD=change-me-local-only
# Host ports are separate from ports inside Docker.
API_PORT=8010
POSTGRES_PORT=5433
# Python started on the host connects to this address.
POSTGRES_HOST=127.0.0.1
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
# Absolute session expiration. Web uses an HttpOnly cookie; Windows keeps its token in memory.
AUTH_SESSION_HOURS=12
# Optional override for managed databases (postgresql+psycopg://...).
# DATABASE_URL=
# Optional local-only school corpus, relative to the repository root on the host.
# Without a corpus, school queries return insufficient_evidence rather than guessing.
# SCHOOL_RAG_CORPUS_PATH=backend/app/rag/output/chunks.jsonl
