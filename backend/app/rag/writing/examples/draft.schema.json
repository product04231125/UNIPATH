{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "course",
            "activity",
            "experience",
            "credential",
            "achievement"
          ],
          "title": "Kind",
          "type": "string"
        },
        "record_id": {
          "format": "uuid",
          "title": "Record Id",
          "type": "string"
        },
        "version": {
          "minimum": 1,
          "title": "Version",
          "type": "integer"
        },
        "excerpt": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "record_id",
        "version",
        "excerpt"
      ],
      "title": "Citation",
      "type": "object"
    },
    "FactRow": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        },
        "label": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        }
      },
      "required": [
        "text",
        "citations",
        "label"
      ],
      "title": "FactRow",
      "type": "object"
    },
    "GroundedText": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "citations": {
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "maxItems": 5,
          "minItems": 1,
          "title": "Citations",
          "type": "array"
        }
      },
      "required": [
        "text",
        "citations"
      ],
      "title": "GroundedText",
      "type": "object"
    },
    "Revision": {
      "additionalProperties": false,
      "properties": {
        "original_excerpt": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Original Excerpt",
          "type": "string"
        },
        "section_index": {
          "maximum": 7,
          "minimum": 0,
          "title": "Section Index",
          "type": "integer"
        },
        "reason": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "original_excerpt",
        "section_index",
        "reason"
      ],
      "title": "Revision",
      "type": "object"
    },
    "Section": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Heading",
          "type": "string"
        },
        "paragraphs": {
          "items": {
            "$ref": "#/$defs/GroundedText"
          },
          "maxItems": 4,
          "title": "Paragraphs",
          "type": "array"
        },
        "facts": {
          "items": {
            "$ref": "#/$defs/FactRow"
          },
          "maxItems": 8,
          "title": "Facts",
          "type": "array"
        }
      },
      "required": [
        "heading"
      ],
      "title": "Section",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "sections": {
      "items": {
        "$ref": "#/$defs/Section"
      },
      "maxItems": 8,
      "minItems": 1,
      "title": "Sections",
      "type": "array"
    },
    "questions_for_user": {
      "items": {
        "maxLength": 120,
        "minLength": 1,
        "type": "string"
      },
      "maxItems": 8,
      "title": "Questions For User",
      "type": "array"
    },
    "revisions": {
      "items": {
        "$ref": "#/$defs/Revision"
      },
      "maxItems": 8,
      "title": "Revisions",
      "type": "array"
    }
  },
  "required": [
    "sections"
  ],
  "title": "Draft",
  "type": "object"
}
