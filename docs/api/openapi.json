{
  "openapi": "3.1.0",
  "info": {
    "title": "UniversityPath AI API",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Health",
        "operationId": "health_api_v1_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Ready",
        "operationId": "ready_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadyResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "503": {
            "description": "Service Unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/assistant/queries": {
      "post": {
        "tags": [
          "assistant"
        ],
        "summary": "Query",
        "operationId": "query_api_v1_assistant_queries_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssistantQueryRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AssistantQueryResponse"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AssistantCitation": {
        "properties": {
          "chunk_id": {
            "type": "string",
            "format": "uuid",
            "title": "Chunk Id"
          },
          "document_id": {
            "type": "string",
            "format": "uuid",
            "title": "Document Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          },
          "page": {
            "type": "integer",
            "minimum": 1.0,
            "title": "Page"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          }
        },
        "type": "object",
        "required": [
          "chunk_id",
          "document_id",
          "title",
          "source_url",
          "page",
          "excerpt"
        ],
        "title": "AssistantCitation"
      },
      "AssistantQueryRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "context": {
            "$ref": "#/components/schemas/SchoolQueryContext"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "AssistantQueryRequest"
      },
      "AssistantQueryResponse": {
        "properties": {
          "query_id": {
            "type": "string",
            "format": "uuid",
            "title": "Query Id"
          },
          "status": {
            "$ref": "#/components/schemas/AssistantStatus"
          },
          "reason": {
            "$ref": "#/components/schemas/AssistantReason"
          },
          "answer": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Answer"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/AssistantCitation"
            },
            "type": "array",
            "title": "Citations"
          },
          "missing_fields": {
            "items": {
              "$ref": "#/components/schemas/MissingContextField"
            },
            "type": "array",
            "title": "Missing Fields"
          }
        },
        "type": "object",
        "required": [
          "query_id",
          "status",
          "reason"
        ],
        "title": "AssistantQueryResponse"
      },
      "AssistantReason": {
        "type": "string",
        "enum": [
          "empty_question",
          "school_context_required",
          "academic_scope_required",
          "conflicting_admission_year",
          "rule_engine_required",
          "no_approved_matching_evidence",
          "document_context_not_approved_or_incomplete",
          "answer_generator_not_configured",
          "invalid_generator_output",
          "invalid_generator_citations",
          "generator_reported_insufficient_evidence",
          "rag_processing_failed",
          "generated_from_evidence"
        ],
        "title": "AssistantReason"
      },
      "AssistantStatus": {
        "type": "string",
        "enum": [
          "grounded",
          "insufficient_evidence",
          "needs_user_input",
          "failed"
        ],
        "title": "AssistantStatus"
      },
      "ErrorCode": {
        "type": "string",
        "enum": [
          "VALIDATION_ERROR",
          "NOT_FOUND",
          "METHOD_NOT_ALLOWED",
          "HTTP_ERROR",
          "SERVICE_UNAVAILABLE",
          "INTERNAL_SERVER_ERROR"
        ],
        "title": "ErrorCode"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "$ref": "#/components/schemas/ErrorCode"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "field_errors": {
            "items": {
              "$ref": "#/components/schemas/FieldError"
            },
            "type": "array",
            "title": "Field Errors"
          },
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message",
          "request_id"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "FieldError": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "reason": {
            "type": "string",
            "title": "Reason"
          }
        },
        "type": "object",
        "required": [
          "field",
          "reason"
        ],
        "title": "FieldError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "HealthResponse"
      },
      "HealthStatus": {
        "type": "string",
        "enum": [
          "ok",
          "ready"
        ],
        "title": "HealthStatus"
      },
      "MissingContextField": {
        "type": "string",
        "enum": [
          "question",
          "institution",
          "department",
          "admission_year",
          "track",
          "graduation_audit"
        ],
        "title": "MissingContextField"
      },
      "ReadyResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "database": {
            "$ref": "#/components/schemas/HealthStatus"
          },
          "pgvector_version": {
            "type": "string",
            "title": "Pgvector Version"
          },
          "migration_revision": {
            "type": "string",
            "title": "Migration Revision"
          }
        },
        "type": "object",
        "required": [
          "status",
          "database",
          "pgvector_version",
          "migration_revision"
        ],
        "title": "ReadyResponse"
      },
      "SchoolQueryContext": {
        "properties": {
          "institution": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Institution"
          },
          "department": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Department"
          },
          "admission_year": {
            "anyOf": [
              {
                "type": "integer",
                "maximum": 9999.0,
                "minimum": 1000.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Admission Year"
          },
          "track": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 64,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Track"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "SchoolQueryContext"
      }
    }
  }
}
